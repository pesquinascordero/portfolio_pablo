# Copia este fichero a .env (en local) o a /etc/portfolio-api.env (en el VPS).
# Nunca subas el fichero real al repositorio.

PORT=3000
# Número de proxies delante de la API (nginx = 1). Necesario para que el rate limit vea la IP real.
TRUST_PROXY=1
# Solo para desarrollo con Vite. En producción, nginx sirve web y API en el mismo origen.
CORS_ORIGIN=http://localhost:5173

SMTP_HOST=smtp.ionos.es
SMTP_PORT=465
SMTP_USER=automatizaciones@pabloesquinas.es
SMTP_PASS=

MAIL_FROM=automatizaciones@pabloesquinas.es
MAIL_TO=pesquinascordero@gmail.com
